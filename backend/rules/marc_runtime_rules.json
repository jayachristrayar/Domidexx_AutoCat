{
  "schema_version": 1,
  "status_model": [
    "SUPPORTED",
    "PARTIAL",
    "OPTIONAL",
    "PROFILE_DEPENDENT",
    "LEGACY",
    "PLANNED",
    "NOT_SUPPORTED"
  ],
  "notes": "Runtime source of truth for AutoCat MARC field behaviour. Cataloguing prose remains in marc_field_rules.json and is attached by tag at load time. Do not claim SUPPORTED unless builder + validator + (mapper or control-field path) are implemented.",
  "series_policy": {
    "target_framework_field": "440",
    "koha_framework_shows": "440",
    "do_not_silently_replace_with": "490",
    "490_8xx_requires": "explicit cataloguing-policy change",
    "status": "PLANNED",
    "notes": "Target Koha 26.05 framework exposes 440 SERIES -- TITLE. AutoCat keeps 440 as the series target. Builder/mapper for 440 are not yet implemented."
  },
  "rules": [
    {
      "tag": "000",
      "aliases": ["LDR"],
      "label": "Leader",
      "description": "MARC21 record leader (24 characters). Control field — no indicators or subfields.",
      "status": "PARTIAL",
      "field_type": "CONTROL_FIELD",
      "repeatable": false,
      "required": true,
      "generation_method": "mechanical",
      "validation": {
        "length": 24,
        "positions": {
          "05": { "name": "record_status", "allowed": ["n", "c", "d", "a", "p"] },
          "06": { "name": "type_of_record", "notes": "Builder default: a (language material)" },
          "07": { "name": "bibliographic_level", "notes": "Builder default: m (monograph)" },
          "09": { "name": "character_coding", "notes": "Builder default: a (UCS/Unicode)" },
          "10": { "name": "indicator_count", "fixed": "2" },
          "11": { "name": "subfield_code_count", "fixed": "2" },
          "17": { "name": "encoding_level", "notes": "Often blank when not coded" },
          "18": { "name": "descriptive_cataloging_form", "notes": "a when profile is AACR2" },
          "20-23": { "name": "entry_map", "fixed": "4500" }
        },
        "incomplete": "Full position-by-position cataloguing validation is not claimed; P1 validates length and basic structural defaults the builder emits."
      },
      "ai_assisted": false,
      "evidence_required": false,
      "cataloguer_review_required": false,
      "koha_supported": true,
      "koha_mapping": {
        "kind": "CONTROL_FIELD",
        "notes": "Mapped as record leader / control field 000, not as variable-field indicators/subfields."
      },
      "profile": "AACR2 + ISBD + MARC21 + Koha",
      "notes": "Builder already generates LDR; registry tag is 000 with alias LDR."
    },
    {
      "tag": "008",
      "label": "Fixed-Length Data Elements",
      "description": "40-character fixed-length control field for books/monographs under the current AACR2 + ISBD + MARC21 profile.",
      "status": "PARTIAL",
      "field_type": "CONTROL_FIELD",
      "repeatable": false,
      "required": true,
      "generation_method": "mechanical",
      "validation": {
        "length": 40,
        "positions_supported": {
          "00-05": { "name": "date_entered", "notes": "YYMMDD; builder-generated" },
          "06": { "name": "type_of_date", "notes": "Builder: s when year known, n when unknown" },
          "07-10": { "name": "date1", "notes": "Publication year or uuuu" },
          "11-14": { "name": "date2", "notes": "Blank for simple monograph" },
          "15-17": { "name": "place_of_publication", "notes": "Not coded when place unknown in data model" },
          "18-34": { "name": "material_specific", "notes": "Not coded by current builder" },
          "35-37": { "name": "language", "notes": "Builder default eng — not source-derived" },
          "38": { "name": "modified_record", "notes": "Blank default" },
          "39": { "name": "cataloging_source", "notes": "Builder default d (other)" }
        },
        "incomplete": "Do not invent validation for positions the application cannot generate or verify."
      },
      "ai_assisted": false,
      "evidence_required": false,
      "cataloguer_review_required": false,
      "koha_supported": true,
      "koha_mapping": {
        "kind": "CONTROL_FIELD"
      },
      "profile": "AACR2 + ISBD + MARC21 + Koha",
      "notes": "Builder already generates a minimal 008 for printed monographs."
    },
    {
      "tag": "020",
      "label": "International Standard Book Number (ISBN)",
