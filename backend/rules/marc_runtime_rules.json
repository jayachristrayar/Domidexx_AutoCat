          "c": { "repeatable": false, "required_when_present": false, "notes": "Transcribing agency — from cataloguing_source.transcribing_agency" },
          "e": { "repeatable": true, "required_when_present": false, "notes": "Description conventions — from cataloguing_source.description_conventions" }
