          "c": { "repeatable": false, "required_when_present": false, "notes": "Terms of availability — optional" },
          "q": { "repeatable": true, "required_when_present": false, "notes": "Qualifying information" },
          "z": { "repeatable": true, "required_when_present": false, "notes": "Canceled/invalid ISBN" }
