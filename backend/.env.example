DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
OPENAI_API_KEY=
# Optional override for the OpenAI API base URL (e.g. to point at a
# compatible proxy/mock during local testing). Leave unset to use OpenAI's
# real endpoint.
OPENAI_BASE_URL=
# Optional: id of an OpenAI vector store holding AutoCat's cataloguing
# knowledge base (DDC 23 guidance, MARC21 rules, local cataloguing policy --
# NOT book-specific facts, which come from web_search instead). Enables two
# additional Model 2 (OpenAI) DDC-classification capabilities when set:
# hosted file_search and application-controlled vector-store retrieval
# (client.vectorStores.search). Leave unset to skip both -- Model 2's DDC
# classification and every other feature work identically without it.
OPENAI_VECTOR_STORE_ID=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
GOOGLE_BOOKS_API_KEY=
LIBRARYTHING_API_KEY=
# Encrypts each user's "Your Own Model" API key at rest (AES-256-GCM) --
# required for that feature to work; a 32-byte value as base64 or hex, or
# any sufficiently long random string. Generate one with e.g.
# `openssl rand -base64 32`. Keep this distinct from every other secret in
# this file, and never change it once real keys have been saved -- rotating
# it makes all previously saved own-API keys undecryptable.
OWN_API_ENCRYPTION_KEY=
# Admin dashboard (/admin). Single shared admin password -- no per-admin
# accounts yet. ADMIN_SESSION_SECRET signs the admin login cookie; use a
# long random value, distinct from any other secret in this file. Both must
# be set in production or /admin/login will refuse to authenticate.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
PORT=10000
# Optional: force plaintext Postgres (local only). Hosted providers need TLS;
# the pool enables TLS automatically for non-localhost DATABASE_URL values.
# PGSSLMODE=disable
