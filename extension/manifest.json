{
  "manifest_version": 3,
  "name": "AutoCat",
  "version": "0.1.1",
  "description": "MARC 21 cataloguing assistant for librarians using Koha.",
  "icons": {
    "16": "assets/logo/icon16.png",
    "48": "assets/logo/icon48.png",
    "128": "assets/logo/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:10000/*",
    "https://domidexx-autocat.onrender.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "AutoCat",
    "default_icon": {
      "16": "assets/logo/icon16.png",
      "48": "assets/logo/icon48.png",
      "128": "assets/logo/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/cgi-bin/koha/cataloguing/addbiblio.pl*"],
      "js": [
        "src/content-scripts/kohaFillEngine.js",
        "src/content-scripts/koha-fill.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
